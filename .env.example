# Copy to .env and fill in. Never commit .env.

# --- API / gateway ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Leave MONGO_URI empty to run an embedded MongoDB (mongodb-memory-server) that persists to .data/db.
# With Docker: MONGO_URI=mongodb://localhost:27017/watch_spaces
MONGO_URI=
USE_MEMORY_DB=true
SEED_ON_BOOT=true

# --- Auth (REQUIRED: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`) ---
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

# --- Seed account passwords (used only by the seed script) ---
SEED_ADMIN_PASSWORD=
SEED_HOST_PASSWORD=
SEED_VIEWER_PASSWORD=

# --- AI co-pilot (optional). Without a key the engine uses its deterministic extractive answerer. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=2500

# --- Real-time tuning ---
HOST_GRACE_MS=10000
RECONNECT_GRACE_MS=8000
