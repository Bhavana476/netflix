{
  "name": "watch-spaces-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node scripts/seed.js",
    "recs:train": "node scripts/trainRecs.js",
    "recs:eval": "node scripts/evalRecs.js",
    "loadtest": "node scripts/loadtest.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "js-yaml": "4.1.0",
    "jsonwebtoken": "9.0.2",
    "mongodb-memory-server": "10.1.3",
    "mongoose": "8.9.5",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testTimeout": 60000
  }
}
